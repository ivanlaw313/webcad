      "deferred": [
        { "commandId": "NewAssemblyFromPartCommand", "reason": "requires save and changes document type" },
        { "commandId": "EnableContactSetsCmd", "reason": "immediate persistent toggle" },
        { "commandId": "EnableAllContactCmd", "reason": "immediate persistent toggle" },
        { "commandId": "DisableAllContactCmd", "reason": "immediate persistent toggle" }
      ]
    }
  }
}
